{
  "name": "video-shrinker",
  "version": "1.0.0",
  "description": "LGO Video Shrinker — application Electron",
  "author": "LGO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.lgo.videoshrinker",
    "productName": "VideoShrinker",
    "win": {
      "target": "nsis",
      "icon": "../static/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "../dist/VideoShrinker",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "main.js",
      "preload.js"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
